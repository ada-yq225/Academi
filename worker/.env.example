# Copy this file to .env; never commit the filled-in file.
APP_ORIGIN=http://127.0.0.1:3200
PORT=3200
HOST=127.0.0.1
DATA_DIR=data
TRUST_PROXY=0
# Generate two different random secrets, each at least 32 characters.
ADMIN_TOKEN=
WORKER_TOKEN=
PORTAL_URL=http://127.0.0.1:3200
WORKER_DATA=worker-data
ACADEMI_EMAIL=
ACADEMI_PASSWORD=
SIMILARITY_PROVIDER=utad
FALLBACK_TURNITIN_USERNAME=
FALLBACK_TURNITIN_PASSWORD=
# Enable only after reviewing the institution's submission/repository policy.
UTAD_DEFAULT_POLICY_ACCEPTED=false
UTAD_HEADLESS=true
PYTHON_BIN=python3
# Optional local executable/module paths; leave unset for normal installations.
# CHROMIUM_PATH=
# PLAYWRIGHT_MODULE=
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=jianpay
JIANPAY_CLIENT_NO=
JIANPAY_KEY=
JIANPAY_GATEWAY=https://jpay.hzjianban.com
PRODUCT_PRICES={"single":0,"five":0,"twenty":0}
# Optional generic payment adapter:
CHECKOUT_URL=
PAYMENT_SECRET=
# Docker HTTPS profile:
DOMAIN=example.com
